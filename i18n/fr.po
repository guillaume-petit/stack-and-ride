msgid "DEBUG_CITY_BASE"
msgstr "Départ"

msgid "DEBUG_CITY_LEGEND"
msgstr "Chaque bâtiment donne sur le carrefour qu'il touche. Noir : départ. Bleu : restaurant. Vert : client (numéro). Rue orange barrée : chantier. Rue grise à pois : pavés. Rue blanche : rue normale."

