# Écran d'accueil provisoire (itération 0)

msgid "GAME_TITLE"
msgstr "Stack & Ride"

msgid "GAME_TAGLINE"
msgstr "Roguelite de livraison à vélo"

msgid "MENU_VERSION"
msgstr "Version %s"

msgid "MENU_COMING_SOON"
msgstr "Le jeu arrive bientôt. Cette version ne contient que le socle du projet."

